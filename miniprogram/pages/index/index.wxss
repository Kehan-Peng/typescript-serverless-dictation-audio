.page { padding: 32rpx 28rpx 80rpx; }
.hero { padding: 28rpx 8rpx 22rpx; display: flex; flex-direction: column; gap: 12rpx; }
.title { font-size: 48rpx; font-weight: 700; color: #14213d; }
.subtitle { font-size: 28rpx; color: #667085; }
.card { margin-top: 24rpx; padding: 32rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 8rpx 28rpx rgba(16, 24, 40, .06); }
.section-title { font-size: 32rpx; font-weight: 650; color: #1d2939; }
.section-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.count, .hint, .result-note { font-size: 24rpx; color: #667085; }
.textarea { box-sizing: border-box; width: 100%; min-height: 300rpx; margin: 24rpx 0; padding: 24rpx; background: #f8fafc; border: 2rpx solid #e4e7ec; border-radius: 16rpx; font-size: 30rpx; line-height: 1.7; }
.primary-button, .secondary-button { margin-top: 24rpx; border-radius: 14rpx; font-size: 30rpx; font-weight: 600; }
.primary-button { color: #fff; background: #2563eb; }
.primary-button[disabled] { color: rgba(255,255,255,.75); background: #94a3b8; }
.secondary-button { color: #344054; background: #eef2f6; }
.preview-header, .preview-row { display: grid; grid-template-columns: 1fr 100rpx 170rpx; align-items: center; column-gap: 16rpx; }
.preview-header { padding: 14rpx 0; border-bottom: 2rpx solid #eaecf0; font-size: 24rpx; color: #667085; }
.preview-row { min-height: 104rpx; border-bottom: 2rpx solid #f2f4f7; }
.word-cell { display: flex; flex-direction: column; padding: 16rpx 0; overflow-wrap: anywhere; }
.word { font-size: 30rpx; }
.warning { margin-top: 6rpx; color: #b54708; font-size: 22rpx; }
.char-count { color: #475467; font-size: 27rpx; }
.pause-editor { display: flex; align-items: center; gap: 8rpx; color: #475467; }
.pause-input { width: 100rpx; height: 62rpx; text-align: center; background: #f8fafc; border: 2rpx solid #d0d5dd; border-radius: 10rpx; }
.field { display: block; margin-top: 24rpx; }
.field-label { display: block; margin-bottom: 12rpx; color: #475467; font-size: 27rpx; }
.text-input { box-sizing: border-box; width: 100%; height: 80rpx; padding: 0 20rpx; background: #f8fafc; border: 2rpx solid #d0d5dd; border-radius: 12rpx; }
.hint { display: block; margin-top: 16rpx; text-align: center; }
.message { margin-top: 24rpx; padding: 22rpx 26rpx; border-radius: 14rpx; font-size: 27rpx; }
.error { color: #b42318; background: #fef3f2; }
.result { border: 2rpx solid #bfdbfe; }
.result-note { display: block; margin-top: 12rpx; }
.player-actions { display: flex; gap: 20rpx; }
.player-button { flex: 1; }
.download-field { display: block; margin-top: 30rpx; padding-top: 26rpx; border-top: 2rpx solid #e5e7eb; }
.download-button { margin-top: 20rpx; color: #fff; background: #059669; border-radius: 14rpx; font-size: 30rpx; font-weight: 600; }
.download-button[disabled] { color: rgba(255,255,255,.75); background: #94a3b8; }
.save-message { display: block; margin-top: 14rpx; color: #047857; font-size: 25rpx; text-align: center; }
.download-hint { display: block; margin-top: 14rpx; color: #667085; font-size: 23rpx; line-height: 1.5; text-align: center; }
